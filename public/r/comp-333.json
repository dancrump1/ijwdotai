      "content": "\"use client\";\n\nimport * as React from \"react\";\n\nimport {\n\tCommandDialog,\n\tCommandEmpty,\n\tCommandGroup,\n\tCommandInput,\n\tCommandItem,\n\tCommandList,\n\tCommandSeparator,\n\tCommandShortcut,\n} from \"@/components/ui/command\";\nimport {\n\tArrowUpRightIcon,\n\tCircleFadingPlusIcon,\n\tFileInputIcon,\n\tFolderPlusIcon,\n\tSearchIcon,\n} from \"lucide-react\";\n\nexport default function Component() {\n\tconst [open, setOpen] = React.useState(false);\n\n\tReact.useEffect(() => {\n\t\tconst down = (e: KeyboardEvent) => {\n\t\t\tif (e.key === \"k\" && (e.metaKey || e.ctrlKey)) {\n\t\t\t\te.preventDefault();\n\t\t\t\tsetOpen((open) => !open);\n\t\t\t}\n\t\t};\n\n\t\tdocument.addEventListener(\"keydown\", down);\n\t\treturn () => document.removeEventListener(\"keydown\", down);\n\t}, []);\n\n\treturn (\n\t\t<>\n\t\t\t<button\n\t\t\t\tclassName=\"border-input bg-background text-foreground placeholder:text-muted-foreground/70 focus-visible:border-ring focus-visible:ring-ring/50 inline-flex h-9 w-fit rounded-md border px-3 py-2 text-sm shadow-xs transition-[color,box-shadow] outline-none focus-visible:ring-[3px]\"\n\t\t\t\tonClick={() => setOpen(true)}\n\t\t\t>\n\t\t\t\t<span className=\"flex grow items-center\">\n\t\t\t\t\t<SearchIcon\n\t\t\t\t\t\tclassName=\"text-muted-foreground/80 -ms-1 me-3\"\n\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t/>\n\t\t\t\t\t<span className=\"text-muted-foreground/70 font-normal\">\n\t\t\t\t\t\tSearch\n\t\t\t\t\t</span>\n\t\t\t\t</span>\n\t\t\t\t<kbd className=\"bg-background text-muted-foreground/70 ms-12 -me-1 inline-flex h-5 max-h-full items-center rounded border px-1 font-[inherit] text-[0.625rem] font-medium\">\n\t\t\t\t\t⌘K\n\t\t\t\t</kbd>\n\t\t\t</button>\n\t\t\t<CommandDialog open={open} onOpenChange={setOpen}>\n\t\t\t\t<CommandInput placeholder=\"Type a command or search...\" />\n\t\t\t\t<CommandList>\n\t\t\t\t\t<CommandEmpty>No results found.</CommandEmpty>\n\t\t\t\t\t<CommandGroup heading=\"Quick start\">\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<FolderPlusIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>New folder</span>\n\t\t\t\t\t\t\t<CommandShortcut className=\"justify-center\">\n\t\t\t\t\t\t\t\t⌘N\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<FileInputIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>Import document</span>\n\t\t\t\t\t\t\t<CommandShortcut className=\"justify-center\">\n\t\t\t\t\t\t\t\t⌘I\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<CircleFadingPlusIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>Add block</span>\n\t\t\t\t\t\t\t<CommandShortcut className=\"justify-center\">\n\t\t\t\t\t\t\t\t⌘B\n\t\t\t\t\t\t\t</CommandShortcut>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t</CommandGroup>\n\t\t\t\t\t<CommandSeparator />\n\t\t\t\t\t<CommandGroup heading=\"Navigation\">\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<ArrowUpRightIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>Go to dashboard</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<ArrowUpRightIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>Go to apps</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t\t<CommandItem>\n\t\t\t\t\t\t\t<ArrowUpRightIcon\n\t\t\t\t\t\t\t\tsize={16}\n\t\t\t\t\t\t\t\tclassName=\"opacity-60\"\n\t\t\t\t\t\t\t\taria-hidden=\"true\"\n\t\t\t\t\t\t\t/>\n\t\t\t\t\t\t\t<span>Go to connections</span>\n\t\t\t\t\t\t</CommandItem>\n\t\t\t\t\t</CommandGroup>\n\t\t\t\t</CommandList>\n\t\t\t</CommandDialog>\n\t\t</>\n\t);\n}\n",
